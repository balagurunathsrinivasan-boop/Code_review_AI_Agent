# Required
GITHUB_TOKEN=replace_with_your_github_token
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Repository selection
# For this standalone local copy, fill these with the GitHub repository path.
# Example: https://github.com/acme/mobile-app means:
# GITHUB_OWNER=acme
# GITHUB_REPO=mobile-app
GITHUB_OWNER=replace_with_github_owner_or_org
GITHUB_REPO=replace_with_repository_name

# Optional: skip the open-PR picker and review one PR directly.
PULL_REQUEST_NUMBER=

# Optional: choose which PRs appear in the picker: open, closed, or all.
PR_LIST_STATE=open

# Optional model/runtime settings
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_INLINE_COMMENTS=20
GITHUB_API_VERSION=
REVIEW_OUTPUT_DIR=review_outputs

# Optional xcodebuild settings
# The agent asks before xcodebuild runs. These settings apply only when
# the reviewer chooses xcodebuild validation.
XCODEBUILD_TIMEOUT_SECONDS=1800
XCODEBUILD_MAX_SCHEMES=3
XCODEBUILD_DESTINATION=
XCODEBUILD_SCHEME=
XCODEBUILD_CONTAINER=
XCODEBUILD_SKIP_TESTS=0
XCODEBUILD_ALLOW_TEST_WITHOUT_DESTINATION=0
XCODEBUILD_EXTRA_ARGS=
